# Copy this file to .env and adjust. .env is git-ignored; never commit real secrets.
# Every setting is optional; the values shown are the defaults unless noted.

# ---------------------------------------------------------------------------
# Web server
# ---------------------------------------------------------------------------
# Signs session cookies. REQUIRED for any shared deployment; if empty a random
# key is generated at startup (sessions then reset on every restart).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

HOST=127.0.0.1
PORT=5000
# Never enable debug mode on a machine reachable by others.
FLASK_DEBUG=false
# Open the browser automatically when running `python app.py`.
OPEN_BROWSER=true
# Maximum total upload size per request, in megabytes.
MAX_UPLOAD_MB=20

# ---------------------------------------------------------------------------
# Authentication (off by default: the app is open to anyone who can reach it)
# ---------------------------------------------------------------------------
AUTH_ENABLED=false
APP_USERNAME=admin
# Hash of the login password (the plain password is never stored). Generate with:
# python -c "from werkzeug.security import generate_password_hash as g; print(g('your-password'))"
APP_PASSWORD_HASH=

# ---------------------------------------------------------------------------
# Summarization and translation
# ---------------------------------------------------------------------------
# Output language preselected in the form: en kn hi bn ta te ml mr gu pa ur es fr de
DEFAULT_LANGUAGE=kn
# simple | balanced | detailed
DEFAULT_SUMMARY_MODE=balanced

# Skip all Hugging Face models and use TF-IDF extractive summaries only.
# Useful on low-memory machines or for quick development.
LIGHTWEIGHT_MODE=false

# Fall back to Google Translate (via deep-translator) when no local model can
# translate. Sends document text to Google; disable for confidential documents.
ENABLE_ONLINE_TRANSLATION=true
# Allow /api/tts to synthesize speech with Google TTS (gTTS). Sends summary text to Google.
ENABLE_ONLINE_TTS=true

# Model overrides (Hugging Face model IDs)
SUMMARIZER_MODEL=facebook/bart-large-cnn
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# Multilingual translator. NLLB-200 covers every supported language and is the
# primary translator for Kannada, Telugu and Tamil (the Marian models produce
# unrelated text for them). It is licensed CC-BY-NC (non-commercial only).
# For commercial use set facebook/mbart-large-50-many-to-many-mmt (MIT licence);
# Kannada/Telugu/Tamil then rely on Google Translate, with Marian as a weak fallback.
MULTILINGUAL_MODEL=facebook/nllb-200-distilled-600M

# Speed (CPU). int8 quantization makes NLLB about 2.7x faster with no quality loss
# seen in tests (it is never applied to BART, which breaks when quantized).
QUANTIZE_TRANSLATION=true
# Translation beam size: 1 = greedy (fastest), 2 = default (about the same speed,
# fewer word errors), 4 = slightly better again but about twice as slow.
TRANSLATION_BEAMS=2
# Load all models in the background when `python app.py` starts (~30 s), so the
# first request does not wait for them. Under gunicorn, call backend.preload_models().
PRELOAD_MODELS=true

# Where Hugging Face caches downloaded models (default: ~/.cache/huggingface)
# HF_HOME=/path/to/cache

# ---------------------------------------------------------------------------
# PDF export
# ---------------------------------------------------------------------------
# Extra directory searched (recursively) for TTF fonts. Indic scripts need Noto
# fonts (Linux: apt install fonts-noto-core) or Nirmala UI (bundled with Windows).
# A ./fonts directory in the project is always searched as well.
PDF_FONT_DIR=
